---
import { getCollection } from 'astro:content';
import Basis from '../layouts/Basis.astro';

export async function getStaticPaths() {
  const steden = await getCollection('steden');
  const aanbieders = await getCollection('aanbieders', (a) => a.data.kinderaanbod !== 'nee');
  return steden.map((stad) => ({
    params: { stad: stad.id },
    props: {
      stad,
      lijst: aanbieders
        .filter((a) => a.data.stad === stad.id)
        .sort((a, b) => Number(b.data.uitgelicht) - Number(a.data.uitgelicht)
          || (a.data.kinderaanbod === 'ja' ? -1 : 1) - (b.data.kinderaanbod === 'ja' ? -1 : 1)
          || a.data.naam.localeCompare(b.data.naam)),
    },
  }));
}
const { stad, lijst } = Astro.props;
const naam = stad.data.naam;
---
<Basis titel={`Kookfeestje ${naam}: kinderkookworkshops in ${naam}`}
  beschrijving={`${lijst.length} aanbieders van kookfeestjes en kookworkshops voor kinderen in ${naam}.`}>
  <h1>Kookfeestje in {naam}</h1>
  <p>{lijst.length} aanbieders van kookfeestjes en kinderkookworkshops in en rond {naam}.</p>
  <ul>
    {lijst.map((a) => (
      <li>
        <h2>{a.data.naam}</h2>
        {a.data.leeftijdVan && <p>Vanaf {a.data.leeftijdVan} jaar{a.data.leeftijdTot && ` t/m ${a.data.leeftijdTot} jaar`}</p>}
        {a.data.prijsPerKindVan && <p>Vanaf € {a.data.prijsPerKindVan.toFixed(2).replace('.', ',')} per kind</p>}
        {a.data.website && <p><a href={a.data.website} rel="nofollow noopener" target="_blank">Website</a></p>}
        <p><small>Bron gecontroleerd op {a.data.laatstGecontroleerd}</small></p>
      </li>
    ))}
  </ul>
</Basis>
